APP_NAME=Tesys

# APP_ENV & APP_DEBUG sengaja diisi nilai PRODUKSI.
#
# Sebelumnya berkas contoh ini berisi APP_ENV=local + APP_DEBUG=true, dan
# composer script "setup" menyalinnya menjadi .env. Deploy yang mengikuti
# prosedur resmi jadi menghasilkan produksi dengan debug aktif: setiap error
# menampilkan stack trace LENGKAP plus dump seluruh variabel environment -
# kredensial database, EXPORT_API_TOKEN, FONNTE_TOKEN, kunci AI - kepada
# siapa pun yang memicunya.
#
# Pengembang lokal menurunkannya sendiri (APP_ENV=local, APP_DEBUG=true);
# arah bawaannya harus aman, bukan nyaman.
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# 'debug' di produksi membanjiri disk dan menyimpan detail yang tidak perlu
# tersimpan. 'warning' cukup untuk menangkap yang bermasalah.
LOG_LEVEL=warning

# Aplikasi ini MySQL-only, bukan pilihan gaya.
#
# Migrasi 2026_09_18_000005 memakai "ALTER TABLE ... MODIFY", Project.php
# memakai CAST(code AS UNSIGNED), FinanceSummaryController memakai
# YEAR()/MONTH(), dan banyak kolom bertipe enum. Tidak satu pun berjalan di
# sqlite - phpunit.xml sudah mencatat alasan yang sama untuk suite uji.
#
# Sebelumnya baris ini berisi DB_CONNECTION=sqlite, sehingga "composer setup"
# pada mesin baru gagal di tengah migrasi dan meninggalkan skema separuh jadi.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tesys
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Payload sesi tersimpan di tabel sessions; enkripsi menutup pembacaannya
# dari dump/backup basis data.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# QUEUE_CONNECTION=database berarti WORKER WAJIB BERJALAN.
#
# AppNotification memakai ShouldQueue, jadi tanpa "php artisan queue:work"
# yang diawasi (supervisor/systemd) TIDAK ADA notifikasi yang pernah
# terkirim - hanya menumpuk di tabel jobs tanpa tanda apa pun. Ini sudah
# pernah terjadi: 21-23 Sep 2026, 1.900+ job menumpuk.
#
# Scheduler juga wajib: cron "php artisan schedule:run" tiap menit, untuk
# forecast:auto-close (lihat routes/console.php).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Integrasi & API internal
# ---------------------------------------------------------------------------
# Token API ekspor Cost Request (dipakai Excel Power Query). Kirim lewat header
# "Authorization: Bearer <token>" atau "X-Export-Token: <token>".
# Kosongkan untuk mematikan endpoint /api/public/budget-request sepenuhnya.
EXPORT_API_TOKEN=

# Notifikasi WhatsApp lewat Fonnte (opsional). Tanpa token, notifikasi tetap
# masuk ke lonceng in-app dan channel WhatsApp dilewati diam-diam.
#
# FONNTE_ENABLED adalah SAKLAR SEBENARNYA dan bawaannya MATI (lihat
# config/services.php). Mengisi FONNTE_TOKEN saja tidak membuat WhatsApp
# terkirim - itu yang membuat orang mengira integrasinya rusak.
FONNTE_ENABLED=false
FONNTE_TOKEN=
FONNTE_API_URL=https://api.fonnte.com/send

# Keamanan sesi. Cookie sesi hanya dikirim lewat HTTPS.
# Turunkan ke false HANYA di lingkungan lokal yang memang melayani http.
SESSION_SECURE_COOKIE=true

